# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Claude API key for the LLM fallback (classification / extraction / vision)
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the fallbacks
ANTHROPIC_MODEL=claude-sonnet-4-5

# Where the dataset lives: a local folder, or the organizers' HTTP server
# e.g. DATA_SOURCE=http://localhost:8080
DATA_SOURCE=data

# Postgres (service layer)
DATABASE_URL=postgresql://sdoc:sdoc@localhost:5432/sdoc

# Redis (job queue)
REDIS_URL=redis://localhost:6379/0
