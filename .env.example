# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# The pipeline runs WITHOUT any of this: with no API key it stays on the deterministic
# path and escalates whatever the rules cannot decide. That is the demo-safe default —
# a dead network or a rate limit must never take the run down.

# Claude API key for the LLM fallback (classification / extraction / vision)
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the fallbacks
ANTHROPIC_MODEL=claude-sonnet-5

# Hard cap on Claude calls per run. The rules resolve the whole sample inbox on their
# own, so a run that reaches this is a run against unfamiliar data; the cap is what
# stops an accidental full-inbox LLM pass from spending a limited budget.
LLM_MAX_CALLS=40

# Where the inbox lives: a folder holding inbox/ and attachments/. Point this at a new
# drop of emails and everything — pipeline, service, screens — follows. No code change.
DATA_DIR=data

# --- deployment (deploy/docker-compose.prod.yml) ---
# The hostname whose DNS A record points at the server. Caddy gets a Let's Encrypt
# certificate for it automatically. Leave as :80 to serve over plain HTTP by IP.
SDOC_DOMAIN=:80
