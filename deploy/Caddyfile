# Caddy terminates TLS and proxies to the app. It obtains and renews a Let's Encrypt
# certificate on its own — no certbot, no cron, no renewal to forget during the event.
#
# SDOC_DOMAIN comes from .env. Set it to the hostname whose A record points at this
# box; use :80 while you are still testing by IP.

{$SDOC_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/access.log
		format console
	}
}
